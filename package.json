{
  "name": "personal-site",
  "version": "1.0.0",
  "homepage": "https://javierchuaby.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/javierchuaby/javierchuaby.github.io.git"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.32.1"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.3",
      "undici": "7.29.0"
    }
  },
  "scripts": {
    "preinstall": "node scripts/enforce-package-manager.mjs",
    "predev": "pnpm run clean",
    "dev": "next dev --turbopack",
    "build": "next build --webpack && next-image-export-optimizer",
    "predeploy": "pnpm test && pnpm run build",
    "deploy": "gh-pages -d out -b gh-pages -t",
    "start": "next start",
    "lint": "biome check .",
    "type-check": "tsc --noEmit",
    "format": "biome format --write . && prettier --write \"**/*.{md,css,scss}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,css,scss}\"",
    "pretest": "pnpm run format:check && pnpm run lint && pnpm run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "analyze": "ANALYZE=true pnpm run build",
    "clean": "rm -rf .next out .swc .turbo tsconfig.tsbuildinfo",
    "clean:all": "pnpm clean && rm -rf node_modules"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@next/third-parties": "^16.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "dayjs": "^1.11.20",
    "markdown-to-jsx": "^9.8.0",
    "next": "^16.3.0",
    "next-image-export-optimizer": "^1.20.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@next/bundle-analyzer": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.5",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
