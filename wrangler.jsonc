{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "javierchuaby-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/*", "!/images/*", "!/favicon.ico"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "javierchuaby.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
